# need to generate database url from neon project
# create separate .env file in the following format:

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# testlab_test: test database URL needs to be added
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/testlab_test?sslmode=require"

# Meta model access: the server does not read these. Send them to POST /v1/credentials.
META_API_KEY=REPLACE_ME
META_BASE_URL=https://META_API_HOST/v1
META_MODEL=MODEL_ID

# NOTE: database connection string must be changed as and when Neon project branch changes